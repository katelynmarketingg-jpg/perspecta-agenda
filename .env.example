# Supabase — preencha com as chaves do seu projeto (Settings → API).
# Enquanto estas variáveis estiverem vazias, o app roda com dados MOCK (lib/mock.ts),
# permitindo navegar todo o fluxo sem banco. Ao preencher, a camada lib/data.ts
# passa a ler/gravar no Supabase automaticamente.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Slug da barbearia (tenant) exibida por padrão. Multi-tenant: cada barbearia
# tem seu próprio branding em lib/mock.ts (ou na tabela `barbearia` do Supabase).
NEXT_PUBLIC_TENANT=navalha
